# Install this outside the repository and keep the live proxy configuration
# operator-owned. The agent container shares only an internal Docker network
# with this proxy; the proxy alone also joins an outbound-capable network.

acl SSL_ports port 443
acl CONNECT method CONNECT
acl model_provider dstdomain api.openai.com .openai.com chatgpt.com .chatgpt.com

http_access allow CONNECT model_provider SSL_ports
http_access deny all

access_log stdio:/var/log/squid/access.log
cache deny all
via off
forwarded_for delete
