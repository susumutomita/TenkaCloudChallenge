#!/usr/bin/env bash
set -euo pipefail

readonly EXPECTED_SELF="/usr/local/libexec/tenkacloud-symphony-agent"
readonly EXPECTED_REPOSITORY="https://github.com/susumutomita/TenkaCloudChallenge.git"
readonly SAFE_PATH="/usr/bin:/bin:/usr/local/bin"
export PATH="$SAFE_PATH"
umask 077

die() {
  printf 'tenkacloud-symphony-agent: %s\n' "$1" >&2
  exit "${2:-78}"
}

required() {
  local name="$1"
  printenv "$name" >/dev/null 2>&1 || die "$name is required"
  [[ -n "${!name}" ]] || die "$name must not be empty"
}

sha256_file() {
  local path="$1"
  if [[ -x /usr/bin/sha256sum ]]; then
    /usr/bin/sha256sum "$path" | /usr/bin/awk '{print $1}'
  elif [[ -x /usr/bin/shasum ]]; then
    /usr/bin/shasum -a 256 "$path" | /usr/bin/awk '{print $1}'
  else
    die "sha256sum or shasum is required"
  fi
}

require_internal_network() {
  local network="$1"
  local actual
  actual="$(docker network inspect --format '{{.Internal}}' "$network" 2>/dev/null)" ||
    die "Docker network $network does not exist"
  [[ "$actual" == "true" ]] || die "Docker network $network must be internal"
}

require_proxy_url() {
  local name="$1"
  local value="${!name}"
  [[ "$value" =~ ^http://[A-Za-z0-9._-]+:[0-9]{2,5}$ ]] ||
    die "$name must be a credential-free http://container-name:port URL"
}

for secret_name in \
  SYMPHONY_TRACKER_TOKEN \
  GITHUB_TOKEN \
  GH_TOKEN \
  AWS_ACCESS_KEY_ID \
  AWS_SECRET_ACCESS_KEY \
  AWS_SESSION_TOKEN; do
  if printenv "$secret_name" >/dev/null 2>&1; then
    die "refusing to start because $secret_name reached the agent launcher"
  fi
done

[[ "${BASH_SOURCE[0]}" == "$EXPECTED_SELF" ]] ||
  die "run only the operator-installed launcher at $EXPECTED_SELF"
[[ ! -L "$EXPECTED_SELF" ]] || die "the installed launcher must not be a symlink"

for name in \
  SYMPHONY_AGENT_LAUNCHER_SHA256 \
  SYMPHONY_AGENT_IMAGE \
  SYMPHONY_BOOTSTRAP_NETWORK \
  SYMPHONY_BOOTSTRAP_PROXY \
  SYMPHONY_AGENT_NETWORK \
  SYMPHONY_AGENT_PROXY \
  SYMPHONY_MODEL_AUTH_FILE; do
  required "$name"
done

[[ "$(sha256_file "$EXPECTED_SELF")" == "$SYMPHONY_AGENT_LAUNCHER_SHA256" ]] ||
  die "installed agent launcher checksum does not match the operator-approved value"
[[ "$SYMPHONY_AGENT_IMAGE" =~ @sha256:[0-9a-f]{64}$ ]] ||
  die "SYMPHONY_AGENT_IMAGE must use an immutable sha256 digest"
[[ -f "$SYMPHONY_MODEL_AUTH_FILE" && ! -L "$SYMPHONY_MODEL_AUTH_FILE" ]] ||
  die "SYMPHONY_MODEL_AUTH_FILE must be a regular non-symlink file"

require_proxy_url SYMPHONY_BOOTSTRAP_PROXY
require_proxy_url SYMPHONY_AGENT_PROXY
require_internal_network "$SYMPHONY_BOOTSTRAP_NETWORK"
require_internal_network "$SYMPHONY_AGENT_NETWORK"

readonly workspace="$PWD"
[[ "$workspace" != *$'\n'* && "$workspace" != *","* ]] ||
  die "workspace path contains a character unsupported by Docker --mount"

if [[ ! -d .git ]]; then
  [[ -z "$(find . -mindepth 1 -maxdepth 1 -print -quit)" ]] ||
    die "new Symphony workspace must be empty before clone"
  GIT_CONFIG_NOSYSTEM=1 git -c credential.helper= -c core.hooksPath=/dev/null clone \
    --filter=blob:none --no-tags "$EXPECTED_REPOSITORY" .
else
  [[ "$(GIT_CONFIG_NOSYSTEM=1 git remote get-url origin)" == "$EXPECTED_REPOSITORY" ]] ||
    die "existing workspace origin is not $EXPECTED_REPOSITORY"
fi

# Codex intentionally protects .git in workspaceWrite mode. Create the
# per-workspace branch here, before app-server starts and approvals become
# blocking. The workspace basename is assigned by Symphony and never evaluated
# as shell input.
workspace_key="${workspace##*/}"
workspace_key="$(printf '%s' "$workspace_key" | /usr/bin/tr -c 'A-Za-z0-9._-' '-')"
workspace_key="${workspace_key#-}"
workspace_key="${workspace_key%-}"
[[ -n "$workspace_key" ]] || die "workspace basename cannot form a safe branch name"
readonly issue_branch="agent/symphony-$workspace_key"
GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
  git check-ref-format --branch "$issue_branch" >/dev/null ||
  die "workspace branch name is invalid"
current_branch="$(
  GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    git symbolic-ref --quiet --short HEAD
)" || die "workspace must have an attached Git branch"
if [[ "$current_branch" != "$issue_branch" ]]; then
  if GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    git show-ref --verify --quiet "refs/heads/$issue_branch"; then
    die "workspace branch $issue_branch exists but is not checked out"
  fi
  GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    git -c core.hooksPath=/dev/null switch -c "$issue_branch" ||
    die "cannot create the isolated workspace branch"
fi

declare -ar common_limits=(
  --rm
  --init
  --pull never
  --read-only
  --cap-drop ALL
  --security-opt no-new-privileges
  --pids-limit 512
  --memory 4g
  --cpus 2
  --user "$(id -u):$(id -g)"
  --workdir "$workspace"
  --mount "type=bind,source=$workspace,target=$workspace"
  --tmpfs "/tmp:rw,nosuid,nodev,size=1g"
)

runtime_directory="$(mktemp -d)" || die "cannot create private runtime directory"
readonly runtime_directory
cleanup() {
  local cid
  for cidfile in "$runtime_directory/bootstrap.cid" "$runtime_directory/agent.cid"; do
    if [[ -s "$cidfile" ]]; then
      cid="$(/bin/cat "$cidfile")"
      docker stop --time 5 "$cid" >/dev/null 2>&1 || true
    fi
  done
  if [[ -f "$runtime_directory/auth.json" ]]; then
    /bin/chmod 600 "$runtime_directory/auth.json"
    /bin/rm -f "$runtime_directory/auth.json"
  fi
  /bin/rm -f "$runtime_directory/bootstrap.cid" "$runtime_directory/agent.cid"
  /bin/rmdir "$runtime_directory" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Dependency preparation has no credential and can reach only the operator's
# package-registry proxy. Lifecycle scripts remain disabled.
docker run \
  "${common_limits[@]}" \
  --cidfile "$runtime_directory/bootstrap.cid" \
  --network "$SYMPHONY_BOOTSTRAP_NETWORK" \
  --env "HTTP_PROXY=$SYMPHONY_BOOTSTRAP_PROXY" \
  --env "HTTPS_PROXY=$SYMPHONY_BOOTSTRAP_PROXY" \
  --env "NO_PROXY=localhost,127.0.0.1" \
  --env "HOME=/tmp/tenkacloud-home" \
  --env "BUN_INSTALL_CACHE_DIR=/tmp/bun-cache" \
  "$SYMPHONY_AGENT_IMAGE" \
  /bin/sh -lc \
  'bun install --frozen-lockfile --ignore-scripts && bun install --cwd battles/microservice-migration-battle/services --frozen-lockfile --ignore-scripts'

/bin/cp "$SYMPHONY_MODEL_AUTH_FILE" "$runtime_directory/auth.json"
/bin/chmod 600 "$runtime_directory/auth.json"

# The agent network is Docker-internal. The only outbound path is an
# operator-owned CONNECT proxy that allowlists model-provider destinations.
docker run \
  -i \
  "${common_limits[@]}" \
  --cidfile "$runtime_directory/agent.cid" \
  --network "$SYMPHONY_AGENT_NETWORK" \
  --mount "type=bind,source=$runtime_directory,target=/run/tenkacloud-auth,readonly" \
  --env "HTTP_PROXY=$SYMPHONY_AGENT_PROXY" \
  --env "HTTPS_PROXY=$SYMPHONY_AGENT_PROXY" \
  --env "NO_PROXY=localhost,127.0.0.1" \
  --env "HOME=/tmp/tenkacloud-home" \
  --env "CODEX_HOME=/tmp/tenkacloud-home/.codex" \
  "$SYMPHONY_AGENT_IMAGE" \
  /bin/sh -lc \
  'mkdir -p -m 700 "$CODEX_HOME" && cp /run/tenkacloud-auth/auth.json "$CODEX_HOME/auth.json" && chmod 600 "$CODEX_HOME/auth.json" && exec codex app-server'
