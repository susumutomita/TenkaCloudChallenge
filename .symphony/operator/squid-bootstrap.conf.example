# This separate, operator-owned proxy is used only by the short dependency
# bootstrap container. The coding-agent container never joins this network.

acl SSL_ports port 443
acl CONNECT method CONNECT
acl package_registry dstdomain registry.npmjs.org

http_access allow CONNECT package_registry SSL_ports
http_access deny all

access_log stdio:/var/log/squid/access.log
cache deny all
via off
forwarded_for delete
