#!/bin/bash
# Input: order ID, decimal quantity, decimal unit price (yen).
# Output: ID,quantity,unit_price,total,checksum. The key never travels in argv.
set -euo pipefail
export LC_ALL=C
[[ $# -eq 3 ]] || exit 64
order_id=$1 quantity_text=$2 price_text=$3
[[ $order_id =~ ^[A-Za-z0-9-]{1,64}$ ]] || exit 65
[[ $quantity_text =~ ^[0-9]{1,3}$ && $price_text =~ ^[0-9]{1,6}$ ]] || exit 65
quantity=$((10#$quantity_text))
unit_price=$((10#$price_text))
(( quantity >= 1 && quantity <= 999 && unit_price <= 999999 )) || exit 65
IFS= read -r settlement_key < /srv/nightshift/backup/settlement.key
[[ $settlement_key =~ ^[a-f0-9]{32}$ ]] || exit 66
total=$((quantity * unit_price))
digest=$(printf '%s|%s|%s|%s|%s' "$order_id" "$quantity" "$unit_price" "$total" "$settlement_key" | /usr/bin/sha256sum)
printf '%s,%s,%s,%s,%s\n' "$order_id" "$quantity" "$unit_price" "$total" "${digest%% *}"
