+export function prepareLegacy() {
+ const legacy=join(forensicRoot,"../integration-evidence/battles/forensic-casebook");
+ const metadata=JSON.parse(readFileSync(join(legacy,"metadata.json"),"utf8"));
+ const bundle=required(buildSync({entryPoints:[join(legacy,"coordination/plugin.ts")],bundle:true,platform:"node",format:"cjs",write:false}).outputFiles[0]).text;
+ const problem=required(coordinationCatalog(forensicRoot).find(p=>p.problemId==="forensic-casebook"));
+ const old={...problem,definition:JSON.stringify({kind:"coordination",metadata,bundle,digest:createHash("sha256").update(bundle).digest("hex")})};
