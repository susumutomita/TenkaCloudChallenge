{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true, "noEmit": true, "isolatedModules": true,
    "jsx": "react-jsx", "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["bun"]
  },
  "include": ["portal/**/*", "dev/**/*", "game/**/*", "coordination/**/*", "tests/**/*"],
  "exclude": ["node_modules"]
}
