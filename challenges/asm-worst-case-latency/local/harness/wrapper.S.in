/* The author-owned frame. Everything here is fixed; the participant contributes
 * exactly one instruction, spliced in at @INSTRUCTION@ and repeated @SPINS@
 * times by the assembler. The same template builds the baseline, so the two
 * sides of the ratio differ in the measured instruction and in nothing else.
 *
 * Why a frame rather than assembling the participant's file: the submitted code
 * is linked into the harness and runs in its address space, so anything the
 * participant is allowed to place outside the measured region can reach the
 * harness's own state. Owning the frame closes that class instead of
 * enumerating it: there is no participant setup, no participant epilogue, and
 * no participant loop.
 *
 * Three things here are load-bearing beyond "the participant did not write it":
 *
 *   The repeat is unrolled. A counted loop keeps its count in a register, and a
 *   register is architectural state the measured instruction can write. Sixty-
 *   four copies have no counter to corrupt: there is nothing to cut the
 *   measurement short with.
 *
 *   Every callee-saved register is saved and restored. The instruction under
 *   test is not ours and may write anywhere it likes; the SysV ABI promises our
 *   caller that %rbx, %rbp and %r12-%r15 survive the call, and the promise is
 *   kept here rather than asked of the participant.
 *
 *   Every register the contract does not define is zeroed. The measured
 *   instruction can therefore only form an address from the arena (mapped
 *   read-only, see arena.c) or from a small integer (unmapped). A store it
 *   builds any other way faults instead of landing in harness memory, which is
 *   what makes the operand rules in splice.py a contract rather than a hope.
 *
 * The registers the measured instruction may rely on:
 *   %r8   the arena entry point for this sample (the pointer ring's head)
 *   %r9   the seed
 *   %rax  the running value that becomes the return, so nothing is dead code
 * Everything else is zero on entry to the region.
 */

    .text
    .globl @SYMBOL@
    .type @SYMBOL@, @function
@SYMBOL@:
    pushq   %rbx
    pushq   %rbp
    pushq   %r12
    pushq   %r13
    pushq   %r14
    pushq   %r15
    movq    %rsp, tc_entry_rsp(%rip)

    movq    %rdi, %r8
    movq    %rsi, %r9
    movq    %rsi, %rax

    xorl    %ebx, %ebx
    xorl    %ecx, %ecx
    xorl    %edx, %edx
    xorl    %esi, %esi
    xorl    %edi, %edi
    xorl    %ebp, %ebp
    xorl    %r10d, %r10d
    xorl    %r11d, %r11d
    xorl    %r12d, %r12d
    xorl    %r13d, %r13d
    xorl    %r14d, %r14d
    xorl    %r15d, %r15d

tc_measured_begin:
    .rept @SPINS@
@INSTRUCTION@
    .endr
tc_measured_end:

    /* An x86-64 instruction that writes memory either names the address in an
     * operand -- which splice.py reads off the decoded form and refuses -- or
     * goes through the stack, which moves %rsp. Nothing may return through a
     * stack it did not leave: the saved registers below it would be whatever the
     * instruction pushed. */
    cmpq    tc_entry_rsp(%rip), %rsp
    jne     .Ltc_stack_moved

    /* Fold whatever the instruction left in %r8 into the result, so a load that
     * chases the ring cannot be optimised away and the checksum sees it. */
    xorq    %r8, %rax
    popq    %r15
    popq    %r14
    popq    %r13
    popq    %r12
    popq    %rbp
    popq    %rbx
    ret

.Ltc_stack_moved:
    ud2
    .size @SYMBOL@, .-@SYMBOL@

/* File-local, so the candidate and the baseline each get their own and neither
 * can name the other's. Unreachable from the measured region: every register
 * that could address it is zero. */
    .lcomm tc_entry_rsp, 8
    .section .note.GNU-stack,"",@progbits
